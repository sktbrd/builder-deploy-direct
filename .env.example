# ──────────────────────────────────────────────────────────────────────────
# builder-deploy-direct — environment variables
# Copy to `.env.local` and fill in. None of these are exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────

# The template repository forked into each user's GitHub account, "owner/repo".
TEMPLATE_REPO=sktbrd/builder-template-app

# Secret used to sign OAuth `state` (CSRF protection). Generate a random value:
#   openssl rand -hex 32
# Falls back to GITHUB_CLIENT_SECRET / VERCEL_CLIENT_SECRET if unset, but set
# it explicitly in production.
OAUTH_STATE_SECRET=

# ── GitHub auth ─────────────────────────────────────────────────────────────
# The deployer supports two modes; GITHUB_REDIRECT_URI is shared by both.
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Mode A — GitHub App (preferred: repo-scoped, narrow permissions).
# Create at: https://github.com/organizations/<org>/settings/apps  (or user settings)
#  - Callback URL  = GITHUB_REDIRECT_URI above
#  - Enable "Request user authorization (OAuth) during installation"
#  - Permissions: Contents: Read/Write, Administration: Read/Write (to fork),
#    Metadata: Read. Workflows: Read/Write if the template ships GH Actions.
# GITHUB_APP_PRIVATE_KEY accepts the PEM with literal \n escapes or real newlines.
# When all five APP vars are set, App mode is used; otherwise it falls back to
# the OAuth App below.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Mode B — GitHub OAuth App (fallback; broad public_repo scope).
# Create at: https://github.com/settings/developers (New OAuth App)
# Authorization callback URL must equal GITHUB_REDIRECT_URI above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Vercel Integration / OAuth ──────────────────────────────────────────────
# Create at: https://vercel.com/dashboard/integrations/create
# - VERCEL_INTEGRATION_SLUG is the integration's URL slug (install entry point).
# - Redirect URL configured on the integration must equal VERCEL_REDIRECT_URI.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=http://localhost:3000/api/vercel/callback
VERCEL_INTEGRATION_SLUG=
