# ──────────────────────────────────────────────────────────────────────────
# builder-deploy-direct — environment variables
# Copy to `.env.local` and fill in. None of these are exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────

# The template repository forked into each user's GitHub account, "owner/repo".
TEMPLATE_REPO=sktbrd/builder-template-app

# Secret used to sign OAuth `state` (CSRF protection). Generate a random value:
#   openssl rand -hex 32
# Falls back to GITHUB_CLIENT_SECRET / VERCEL_CLIENT_SECRET if unset, but set
# it explicitly in production.
OAUTH_STATE_SECRET=

# ── GitHub OAuth App ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers (New OAuth App)
# Authorization callback URL must equal GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# ── Vercel Integration / OAuth ──────────────────────────────────────────────
# Create at: https://vercel.com/dashboard/integrations/create
# - VERCEL_INTEGRATION_SLUG is the integration's URL slug (install entry point).
# - Redirect URL configured on the integration must equal VERCEL_REDIRECT_URI.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=http://localhost:3000/api/vercel/callback
VERCEL_INTEGRATION_SLUG=
